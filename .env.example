# Copy to .env.local and fill in. Never commit .env.local.
# Leave the Supabase values empty to run the browser-only demo locally.

# --- AI (server only)
ANTHROPIC_API_KEY=

# --- Supabase: accounts + database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- App
NEXT_PUBLIC_APP_URL=http://localhost:5180
# Business details shown on the site and legal pages (hidden if empty)
NEXT_PUBLIC_COMPANY_LEGAL_NAME=LionsLane
NEXT_PUBLIC_COMPANY_CITY=Nairobi, Kenya
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=
# Extra origins allowed to call the API with a Bearer token (comma-separated)
CORS_ORIGINS=

# --- Optional tuning
EMMA_JURY_EFFORT=medium

# --- Stripe (cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=

# --- M-Pesa (Daraja STK push)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTYB=
